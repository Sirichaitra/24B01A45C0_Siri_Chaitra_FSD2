<!DOCTYPE html>
<html>

<head>
    <title>Registration Form</title>
</head>

<body>

    <h1>Student Registration</h1>

    <form action="/submit" method="POST">

        <label>Name:</label>
        <input type="text" name="name">
        <br><br>

        <label>Email:</label>
        <input type="text" name="email">
        <br><br>

        <label>Age:</label>
        <input type="number" name="age">
        <br><br>

        <button type="submit">Submit</button>

    </form>

</body>

</html>